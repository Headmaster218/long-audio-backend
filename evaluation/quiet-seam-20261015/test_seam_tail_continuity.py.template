def fixture_path(value):
    if not isinstance(value, (str, bytes, os.PathLike)):
        return False
    path = Path(os.fsdecode(value)).absolute()
    return path == FIXTURE or FIXTURE in path.parents


def audit_guard(event, args):
    if (event.startswith(('subprocess.', 'socket.', 'sqlite3.connect'))
            or event in ('os.system', 'os.posix_spawn', 'os.fork', 'os.forkpty', 'ctypes.dlopen')):
        raise AssertionError('Forbidden test action: ' + event)
    if event == 'import' and any(args[0] == name or args[0].startswith(name + '.') for name in BLOCKED_IMPORTS):
        raise AssertionError('Forbidden model/runtime import: ' + args[0])
    if event == 'open' and isinstance(args[0], (str, bytes)):
        name = os.fsdecode(args[0])
        if name.endswith(('.audio', '.sqlite', '.sqlite3', '.db')):
            raise AssertionError('Original audio/DB access forbidden')
        mode, flags = args[1], args[2]
        writing = ((isinstance(mode, str) and any(c in mode for c in 'wax+'))
                   or (isinstance(flags, int) and flags & (os.O_WRONLY | os.O_RDWR | os.O_CREAT | os.O_TRUNC)))
        if writing and not fixture_path(name):
            raise AssertionError('Write outside fresh fixture leaf')
    if event in ('os.mkdir', 'os.rmdir', 'os.remove') and not fixture_path(args[0]):
        raise AssertionError('Filesystem mutation outside fresh fixture leaf: ' + event)
    if event in ('os.rename', 'os.link', 'os.symlink', 'os.truncate', 'os.chmod', 'os.chown'):
        raise AssertionError('Unneeded filesystem mutation: ' + event)


