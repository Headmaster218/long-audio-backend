+@pytest.mark.parametrize('changed',['source','receipt'])
+def test_fresh_binding_rejects_valid_mutation(legacy_store,monkeypatch,changed):
+    store=legacy_store;path=store.settings.data_dir/'uploads'/'recovery.audio'
