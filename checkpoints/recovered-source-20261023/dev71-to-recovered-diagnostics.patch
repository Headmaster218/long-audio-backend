+@pytest.mark.parametrize('invalid', ['wall', 'cpu', 'thread', 'counter', 'order', 'clock'])
+def test_invalid_stage_samples_hide_all_rows(rig, monkeypatch, invalid):
+    with pytest.raises(sqlite3.OperationalError):
