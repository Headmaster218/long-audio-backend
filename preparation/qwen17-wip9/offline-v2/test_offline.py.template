class Clock:
    def __init__(self): self.now = 1.0
    def __call__(self): return self.now
    def sleep(self, seconds): self.now += seconds


def pin(data):
    return {'bytes':len(data), 'sha256':hashlib.sha256(data).hexdigest()}


def record_bytes(payloads, name):
    output = io.StringIO(newline='')
    writer = csv.writer(output, lineterminator='\n')
    for row in payloads:
        digest = base64.urlsafe_b64encode(bytes.fromhex(row['sha256'])).decode('ascii').rstrip('=')
        writer.writerow((row['name'], 'sha256='+digest, str(row['bytes'])))
    writer.writerow((name, '', ''))
    return output.getvalue().encode('utf-8')


class Tests(unittest.TestCase):
    def setUp(self):
        OUTER.check()
        self.root = Path(tempfile.mkdtemp(dir=OUTER.temp_root, prefix='offline-case-'))
        self.clock = Clock()
        self.ctx = a.Context(self.root, 1000., self.root/'STOP', self.clock, self.clock.sleep)
        self.serial = 0

    def tearDown(self):
        # No TemporaryDirectory, unlink, rmtree, cleanup, or retry deletes evidence.
        self.assertLessEqual(a.offline_parent.component_bytes(a, OUTER.temp_root, OUTER.check), FIXTURE_CAP)
        OUTER.check()

    def directory(self):
        self.serial += 1
        result = self.root/('fixture-%03d' % self.serial)
        result.mkdir(mode=0o700)
        return result

    def put(self, path, data):
        path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        with path.open('xb') as output: output.write(data)
        return path

    def payloads(self):
        return [('fixture/__init__.py', b'# synthetic only\n'),
