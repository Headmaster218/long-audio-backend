        name = 'fixture-0.2.3.dist-info/RECORD'
        raw = record_bytes(payloads, name)
        first = raw.splitlines()[0].split(b',')
        for wrong_digest, wrong_size in [(b'md5=' + b'A'*43, first[2]),
                                         (b'sha256=' + b'A'*43, first[2]),
                                         (first[1], b'00'), (first[1], b'-1'),
                                         (first[1], b'99999999999'), (first[1], b'0')]:
            changed = b','.join((first[0], wrong_digest, wrong_size))+b'\n'+b'\n'.join(raw.splitlines()[1:])+b'\n'
            with self.assertRaises(a.Refused): i.validate_record(a, changed, payloads, name)
        with self.assertRaises(a.Refused): i.validate_record(a, b'x'*(i.RECORD_CAP+1), payloads, name)
        with self.assertRaises(a.Refused): i.validate_record(a, raw, payloads+payloads[:1], name)
        with self.assertRaises(a.Refused): i.validate_record(a, raw, payloads, payloads[0]['name'])

