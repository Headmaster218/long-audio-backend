        for name in ('model.gguf', 'clip.wav', 'clip.FLAC', 'clip.mp3', 'clip.ogg', 'clip.pcm', 'clip.f32'):
            with self.assertRaises(RuntimeError): audit('open', (str(self.root/name), 'rb', 0))
