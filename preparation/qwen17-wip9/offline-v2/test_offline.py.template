    def wheel(self, *, payloads=None, record=None, members=None, transform=None, method=zipfile.ZIP_STORED):
        payloads = self.payloads() if payloads is None else payloads
        rows = [{'name':name, **pin(data)} for name, data in payloads]
        record_name = 'fixture-0.2.3.dist-info/RECORD'
        raw_record = record_bytes(rows, record_name) if record is None else record
        entries = payloads+[(record_name, raw_record)] if members is None else members
        output = io.BytesIO()
        with zipfile.ZipFile(output, 'w', compression=method) as archive:
            for name, data in entries:
                info = zipfile.ZipInfo(name, date_time=(1980, 1, 1, 0, 0, 0))
                info.compress_type = method
                info.create_system = 3
                info.external_attr = (stat.S_IFREG | 0o644) << 16
                archive.writestr(info, data)
        raw = output.getvalue()
        if transform is not None: raw = transform(raw)
        path = self.put(self.directory()/'synthetic.whl', raw)
        wheel = {'id':'synthetic', **pin(raw), 'installed_files':rows, 'record_name':record_name}
        return path, wheel, raw_record

    def extract(self, path, wheel):
        site = self.directory()/'site'
        aggregate = {'members':0, 'expanded_bytes':0}
        result = i.extract_exact_wheel(a, self.ctx, path, wheel, site, aggregate)
        return site, result, aggregate

