class BoundedResult(unittest.TestResult):
    """Retain only fixed test IDs/statuses; never format or retain tracebacks."""
    def __init__(self):
        super().__init__()
        self.rows = {}

    def startTest(self, test):
        OUTER.check()
        super().startTest(test)
        self.rows[test._testMethodName] = 'PASS'

    def addFailure(self, test, error): self.rows[test._testMethodName] = 'FAIL'
    def addError(self, test, error): self.rows[test._testMethodName] = 'ERROR'
    def addSkip(self, test, reason): self.rows[test._testMethodName] = 'SKIP'
    def addExpectedFailure(self, test, error): self.rows[test._testMethodName] = 'FAIL'
    def addUnexpectedSuccess(self, test): self.rows[test._testMethodName] = 'FAIL'

    def addSubTest(self, test, subtest, error):
        if error is not None: self.rows[test._testMethodName] = 'FAIL'

    def wasSuccessful(self):
        return bool(self.rows) and all(value == 'PASS' for value in self.rows.values())


def main():
    result = BoundedResult()
    real_import = builtins.__import__
    def guarded_import(name, *args, **kwargs):
        if name.split('.', 1)[0] in {'torch', 'transcribe_cpp', 'transcribe_cpp_native', 'psutil', 'audio_backend'}:
            raise AssertionError('package imports forbidden')
        return real_import(name, *args, **kwargs)
    with mock.patch.object(a.urllib.request.OpenerDirector, 'open', side_effect=AssertionError('network forbidden')), \
         mock.patch.object(os, 'execve', side_effect=AssertionError('real exec forbidden')), \
         mock.patch.object(os, 'system', side_effect=AssertionError('shell forbidden')), \
         mock.patch.object(builtins, '__import__', side_effect=guarded_import):
        suite = unittest.defaultTestLoader.loadTestsFromTestCase(Tests)
        expected = suite.countTestCases()
        suite.run(result)
    report = {'schema':'qwen17-offline-fixtures-v1', 'tests_run':result.testsRun,
              'expected_count':expected, 'test_count':len(result.rows),
              'tests':[{'id':name, 'status':status} for name, status in sorted(result.rows.items())],
              'status':'PASS' if result.wasSuccessful() and result.testsRun == expected else 'FAIL'}
    h.bounded_json_size(report, 16384, lambda: OUTER.check(cleanup=True))
    a.write_json(OUTER.run_directory/'offline-fixtures.json', report, OUTER, cleanup=True)
    return 0 if report['status'] == 'PASS' else 1


if __name__ == '__main__':
    raise SystemExit(a.cli_boundary(main))
