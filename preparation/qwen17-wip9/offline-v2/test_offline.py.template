    def test_08_reused_audit_crc_mismatch(self):
        def corrupt(raw):
            value = bytearray(raw)
            nlen, xlen = struct.unpack_from('<HH', value, 26)
            value[30+nlen+xlen] ^= 1
            return bytes(value)
        path, wheel, _ = self.wheel(transform=corrupt)
        with mock.patch.object(i.zipfile, 'ZipFile', side_effect=AssertionError('audit must precede ZipFile')) as opened:
            with self.assertRaises(a.Refused): self.extract(path, wheel)
            opened.assert_not_called()

    def test_09_reused_audit_member_expansion(self):
        def declared_huge(raw):
            value = bytearray(raw)
            central = value.index(b'PK\x01\x02')
            struct.pack_into('<I', value, 22, i.WHEEL_LIMITS['per_member_bytes']+1)
            struct.pack_into('<I', value, central+24, i.WHEEL_LIMITS['per_member_bytes']+1)
            return bytes(value)
        path, wheel, _ = self.wheel(transform=declared_huge)
        with mock.patch.object(i.zipfile, 'ZipFile', side_effect=AssertionError('audit first')) as opened:
            with self.assertRaises(a.Refused): self.extract(path, wheel)
            opened.assert_not_called()

