        for event in ('socket.__new__', 'socket.connect', 'socket.bind', 'socket.getaddrinfo',
                      'socket.gethostbyname', 'subprocess.Popen', 'os.system', 'os.posix_spawn',
                      'os.fork', 'os.forkpty', 'os.exec'):
