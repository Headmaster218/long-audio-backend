              sys.flags.dont_write_bytecode==1 and Path(sys.executable)==c.OLD_PYTHON,'copy_entry')
    install,a,ctx,value,pins=c.load_all();c.verify_source(a,ctx)
    c.require(not c.RUNTIME.exists() and not c.RUNTIME.is_symlink() and
              not c.STAGING.exists() and not c.STAGING.is_symlink(),'fresh_runtime_only')
