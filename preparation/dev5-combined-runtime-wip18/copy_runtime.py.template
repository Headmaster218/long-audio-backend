            'runtime_root':str(c.RUNTIME),'files':2090,'logical_bytes':224293277,
            'inventory':{'path':str(c.HERE/'RUNTIME_INVENTORY.json'),**a.hash_file(c.HERE/'RUNTIME_INVENTORY.json',ctx)},
