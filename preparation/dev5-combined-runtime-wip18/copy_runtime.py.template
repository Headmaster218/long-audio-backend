"""One bounded manifest-selected offline copy; no runtime/package execution."""
import importlib.util
from pathlib import Path
import os
import sys

HERE=Path(__file__).resolve().parent
spec=importlib.util.spec_from_file_location('dev5_combined',HERE/'combined.py')
c=importlib.util.module_from_spec(spec);spec.loader.exec_module(c)


def main():
