 'OWNER_COMPLETION.json':65536,'OWNER_ACCEPTANCE.json':65536}
LIMITS={'absolute_seconds':420,'setup_seconds':60,'compute_seconds':300,'cleanup_seconds':60,
 'cpus':[0,1],'nice':19,'address_space_bytes':8*GIB,'driver_sampled_rss_bytes':int(3.5*GIB),
 'aggregate_sampled_rss_bytes':4*GIB,'old_unknown_rss_reserve_bytes':512*MIB,
