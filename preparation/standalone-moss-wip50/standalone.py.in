HERE=BASE/'@GENERATED_PACKET_ROOT_REL@'
OUT=BASE/'@GENERATED_CONTROL_ROOT_REL@'
RUN=HERE/'runs/@GENERATED_RUN_NAME@'
PRODUCT=BASE/'@GENERATED_PRODUCT_ROOT_REL@'
PYTHON=BASE/'@GENERATED_PYTHON_EXECUTABLE_REL@'
SITES=PYTHON.parent.parent/'lib/python3.12/site-packages'
ARCHIVE=BASE/'@GENERATED_INPUT_ARCHIVE_REL@'
PCM=ARCHIVE/'@GENERATED_PCM_INPUT_REL@';PROOF=ARCHIVE/'@GENERATED_PROOF_INPUT_REL@'
