  state['launch_count']+=1;return original_popen(argv,*args,**kwargs)
 qcr.subprocess.Popen=spawn
 def deny(event,args):
  if event=='sqlite3.connect' or event.startswith('socket.') or event in ('os.system','os.fork','os.forkpty','os.exec','os.posix_spawn','os.spawn'):
   raise RuntimeError('standalone_forbidden:'+event)
  if event=='open' and isinstance(args[0],(str,bytes)):
   p=os.fsdecode(args[0]);need('.sqlite3' not in p,'database_open_forbidden')
 sys.addaudithook(deny)
 try:
  current_end[0]=compute_end
