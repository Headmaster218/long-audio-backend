  write(RUN/'admission.json',{'schema':'moss-standalone-admission-v1','release_sha256':release_sha,
   'source_manifest':release['source_manifest'],'parent_pid':os.getpid(),'parent_start_ticks':int(Path('/proc/self/stat').read_text().rsplit(')',1)[1].split()[19]),
   'python':str(PYTHON),'input_PCM':PCM_PIN,'input_proof':PROOF_PIN,'limits':LIMITS,'clock':state.copy()},65536,compute_end)
  controller=MossController(RUN/'slot',profile_name=PROFILE,model_path=str(MODEL),_service_gate=gate)
  support=SourceSupport.from_dict(support_doc)
  def cancel(signum=None,frame=None):controller._cancel.set()
  for sig_num in (signal.SIGTERM,signal.SIGINT,signal.SIGHUP):signal.signal(sig_num,cancel)
  stopped=threading.Event()
  def watchdog():
   if not stopped.wait(max(0,compute_end-time.monotonic())):cancel()
  watcher=threading.Thread(target=watchdog,daemon=True);watcher.start()
  job_id=controller.submit(support,pcm);pcm=None
  status=controller.run(job_id)
  gate.cleaning();state['controller_status']=status_summary(status)
  retained={}
  for name in ('raw.bin','result.json'):
   p=RUN/'slot'/name
   if p.exists():
    r=read(p,SLOT_CAPS[name],end=gate.cleanup_end);retained[name]={'path':str(p),'bytes':len(r),'sha256':sha(r)}
  state['diagnostic']=write(RUN/'diagnostic.json',diagnostic_document(status,{'schema':'moss-standalone-diagnostic-v1','scope':state['scope'],'retained_native_files':retained,
   'input_PCM':PCM_PIN,'input_proof':PROOF_PIN,'public_API_evidence':False,'complete_content':False,
   'generated_token_count':None,'eos':None}),262144,gate.cleanup_end)
  need(status['cleanup'].get('cleanup_verified') is True and status['cleanup'].get('original_handle_waited_and_reaped') is True and
   status['cleanup'].get('remaining_live_owned')==[],'positive_owned_cleanup')
  need(status['state']=='returned_diagnostic','standalone_diagnostic_failed')
 except BaseException as error:
  state['errors'].append(type(error).__name__+':'+str(error)[:400])
 finally:
  gate.cleaning();end=gate.cleanup_end
  if 'stopped' in locals():
   stopped.set();watcher.join(timeout=min(1.,max(0.,end-time.monotonic())))
   state['watchdog_joined']=not watcher.is_alive()
   if watcher.is_alive():state['errors'].append('watchdog_cleanup_unconfirmed')
  else:state['watchdog_joined']=True
  # Raw files are intentionally retained even if the controller rejected parsing or status.
  for name in ('raw.bin','result.json'):
   p=RUN/'slot'/name
   if p.exists():
    try:r=read(p,SLOT_CAPS[name],end=end);state[name]={'path':str(p),'bytes':len(r),'sha256':sha(r)}
    except Exception as e:state['errors'].append(type(e).__name__+':retained_'+name)
  cleanup=None
  if controller is not None and controller._job is not None:cleanup=controller._job.get('cleanup')
  if cleanup is None:
   cleanup={'cleanup_verified':state['launch_count']==0,'original_handle_waited_and_reaped':state['launch_count']==0,
    'remaining_live_owned':[] if state['launch_count']==0 else None,'cleanup_scope':'no-child-created' if state['launch_count']==0 else 'UNKNOWN'}
  state['cleanup']=cleanup
  try:
   source_manifest(release['source_manifest'],end)
   for p,pin in source_pins.items():read(p,16*MIB,pin,end)
   for p,pin in finder.seen.items():read(p,pin['bytes'],pin,end)
   read(PCM,640000,PCM_PIN,end);read(PROOF,65536,PROOF_PIN,end)
   check_descriptor(MODEL,release['model_descriptor'],pins[str(MODEL)])
   check_descriptor(NATIVE,release['native_descriptor'],pins[str(NATIVE)])
   state['source_final']=True;state['input_final']=True;accounting(end)
  except Exception as e:state['errors'].append(type(e).__name__+':'+str(e)[:400]);state['source_final']=False
  state['status']='COMPLETE_STANDALONE_DIAGNOSTIC' if not state['errors'] else 'FAIL_CLOSED'
  state['elapsed_seconds']=time.monotonic()-START
  try:
   write(RUN/'cleanup.json',cleanup,65536,end);write(RUN/'terminal.json',state,65536,end)
  finally:log.flush();os.fsync(log.fileno());sys.stdout=sys.__stdout__;sys.stderr=sys.__stderr__;log.close()
 print(json.dumps({'status':state['status'],'run':str(RUN),'raw':state.get('raw.bin'),'cleanup':cleanup.get('cleanup_verified')}))
 return 0 if not state['errors'] else 1

if __name__=='__main__':
 need(len(sys.argv)==3 and sys.argv[1]=='--actual','fixed_actual_entry')
 raise SystemExit(main(sys.argv[2]))
