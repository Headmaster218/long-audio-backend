def freeze_phase(cli,runner,run,work_end):
    rows,asts=fixtures()
    out=run/'tmp/preparation';out.mkdir(mode=0o700)
    write(out/'adapter-fixtures.json',{'tests':rows,'status':'PASS','count':8,'guard_method_asts':asts},16384)
    lineage=json.loads(launch.read(HERE/'LINEAGE.json',8192))
    from project_historical_candidate import validate_lineage
    validate_lineage(lineage)
    for name,value in [('source-plan.json',lineage['source_plan']),
                       ('source-bindings.json',lineage['source_bindings']),('limits.json',launch.LIMITS)]:
        write(out/name,value,8192)
    result=invoke(cli,['freeze','--output',str(out),'--source-plan',str(out/'source-plan.json'),
        '--source-bindings',str(out/'source-bindings.json'),'--runtime-manifest',str(Q/'__LOCAL_RUNTIME_MANIFEST_RELATIVE_PATH__'),
        '--limits',str(out/'limits.json'),'--source-scope',lineage['generation_mapping']['cli_source_scope'],
        '--source-generation','0','--model-profile',lineage['model_profile']],out/'freeze-show.json',work_end)
    frozen=runner.read_json(out/'frozen.json')
    launch.require(result['windows']==1 and result['submitted_frames_if_run_once']==307040
            and result['inference_executed'] is False and result['frozen_sha256']==launch.digest(frozen),
            'one_model_free_frozen_window')
    guard=runner.make_guard(out,launch.LIMITS,read_only=True);guard.deadline=work_end
    with runner.preflight_scope(guard,min(180,max(1,int(work_end-time.monotonic())))):
        inventory=material_rows(runner,frozen,out)
    prepared={'schema':'qwen17-historical-prepared-v1','frozen':runner.file_receipt(out/'frozen.json'),
              'frozen_sha256':result['frozen_sha256'],'candidate_id':frozen['requests'][0]['candidate_id'],
              'fixtures_passed':8,'model_calls':0,'hash_inventory':inventory,
              'bookkeeping_cap_bytes':launch.BOOKKEEPING_CAP,'actual_GO_required':True}
    write(out/'prepared.json',prepared,256*1024)
    launch.require(not any(n.startswith('transcribe_cpp') for n in sys.modules),'no_provider_import_in_freeze')
    check(work_end)
    print(json.dumps({'status':'FROZEN_MODEL_FREE','prepared':str(out/'prepared.json'),
                      'frozen_sha256':result['frozen_sha256'],'tests_passed':8,'model_calls':0}))
    return 0


def actual_phase(cli,runner,authority_path,run,absolute_end):
    start=absolute_end-1200
    raw=launch.read(authority_path)
    launch.require(hashlib.sha256(raw).hexdigest()==os.environ['REAL_CAPTURE_SPEC_SHA256'],
                   'authority_handoff_pin')
    authority=json.loads(raw)
    prepared=json.loads(launch.read(authority['prepared']['path']))
    launch.require(hashlib.sha256(launch.read(authority['prepared']['path'])).hexdigest()
                   ==authority['prepared']['sha256'],'prepared_pin')
    frozen=runner.read_json(prepared['frozen']['path'])
    launch.require(launch.digest(frozen)==authority['frozen_sha256'] and frozen['limits']==launch.LIMITS,
                   'frozen_actual_limits')
    out=Path(authority['output_dir'])
    launch.require(out==run/'tmp/candidate' and out.is_dir() and not list(out.iterdir()),'fresh_actual_output')
    error=None;owner=None;projection=None;late=False;phase_end=start+930
    try:
        launch.require(call_allowed(start,time.monotonic()),'bootstrap_call_deadline')
        invoke(cli,['run','--output',str(out),'--frozen',prepared['frozen']['path'],
            '--expected-sha256',authority['frozen_sha256'],'--approval',authority['approval_receipt']['path']],
            out/'run-events.json',start+930)
        phase_end=start+960
        candidate_id=prepared['candidate_id']
        invoke(cli,['show','--output',str(out),'--candidate-id',candidate_id],out/'show.json',start+960)
        from audio_backend.qwen_candidate_store import CandidateStore
        from project_historical_candidate import project_candidate
        store=CandidateStore(out);stored=store.request(candidate_id);events=store.events(0,100)
        owners=[r['payload'] for r in events['events'] if r['kind']=='owner_receipt']
        launch.require(not events['has_more'] and len(owners)==1,'one_runner_owner_receipt')
        owner=owners[0]
        launch.require(owner['original_handle_waited_and_reaped'] is True
            and owner['cleanup_verified'] is True and owner['remaining_live_owned']==[]
            and owner.get('failure') is None and owner.get('wait_returncode')==0,'runner_terminal_cleanup')
        write(out/'stored-evidence.json',stored,512*1024)
        lineage=json.loads(launch.read(HERE/'LINEAGE.json',8192))
        alternative,projection=project_candidate(lineage,frozen,stored,expected_frozen_sha256=authority['frozen_sha256'])
        with (out/'native.raw').open('xb') as stream: stream.write(alternative.raw)
        write(out/'alternative.json',alternative.to_dict(),256*1024)
        write(out/'projection.json',projection,8192)
        check(start+960)
    except Exception as exc:
        error=type(exc).__name__;late=time.monotonic()>=phase_end
    post_start=time.monotonic()
    guard=runner.make_guard(out,launch.LIMITS,read_only=True);guard.deadline=start+1140
    with runner.preflight_scope(guard,180):
        for item in prepared['hash_inventory']: runner.verify_file(item)
    post={'all_matched':True,'files':len(prepared['hash_inventory']),
          'bytes':sum(x['bytes'] for x in prepared['hash_inventory']),
          'inventory_sha256':launch.digest(prepared['hash_inventory']),
          'elapsed_seconds':time.monotonic()-post_start}
    write(out/'posthash.json',post,65536)
    result={'schema':'qwen17-historical-actual-result-v1','status':'RECORDED' if error is None else 'INCOMPLETE',
            'frozen_sha256':authority['frozen_sha256'],'error_type':error,'posthash':post,
            'runner_original_reaped':bool(owner and owner.get('original_handle_waited_and_reaped')),
            'runner_cleanup_verified':bool(owner and owner.get('cleanup_verified')),'late_phase':late,
            'projection_present':projection is not None,'complete_content':False,'eos':None,
            'bookkeeping_cap_bytes':launch.BOOKKEEPING_CAP,'historical_original_status':'INCOMPLETE'}
    write(out/'actual-result.json',result,65536)
    check(start+1140)
    return 0 if error is None else 1


def main():
    parser=argparse.ArgumentParser();parser.add_argument('--mode',choices=('freeze','actual'),required=True)
    parser.add_argument('--authority',type=Path);args=parser.parse_args()
    launch.require(Path(sys.executable).resolve()==launch.PYTHON,'copied_runtime_interpreter')
    run=Path(os.environ['GUARD_RUN_DIRECTORY']);absolute=float(os.environ['GUARD_ABSOLUTE_END'])
    work=float(os.environ['GUARD_WORK_END'])
    launch.require(run.parent==Q/'runs' and absolute-work==60,'original_guard_deadlines')
    from audio_backend import qwen_candidate_runner as runner
    cli=load('candidate_unchanged_CLI',P/'scripts/benchmarks/run_qwen_candidates.py')
    return (freeze_phase(cli,runner,run,work) if args.mode=='freeze'
            else actual_phase(cli,runner,args.authority,run,absolute))


if __name__=='__main__':
    try: raise SystemExit(main())
    except Exception:
        print(json.dumps({'status':'FAILED','error_type':'CandidateEntryFailure'}))
        raise SystemExit(1) from None
