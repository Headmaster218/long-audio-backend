def check(end):
    launch.require(time.monotonic()<end and not Path(os.environ['GUARD_STOP_PATH']).exists(),
                   'fixed_phase_deadline_or_STOP')


def call_allowed(start,now):
    # One second of the30-second bootstrap lane is retained for fixed CLI dispatch.
    return start<=now<start+29


def load(name,path):
    spec=importlib.util.spec_from_file_location(name,path)
    value=importlib.util.module_from_spec(spec);spec.loader.exec_module(value)
    return value


def write(path,value,limit=2**20):
    raw=(json.dumps(value,sort_keys=True,indent=2,allow_nan=False)+'\n').encode()
    launch.require(len(raw)<=limit,'output_bound')
    with Path(path).open('xb') as stream:
        stream.write(raw);stream.flush();os.fsync(stream.fileno())


class BoundedText(io.StringIO):
    def __init__(self): super().__init__();self.bytes=0
    def write(self,text):
        self.bytes+=len(text.encode())
        launch.require(self.bytes<=512*1024,'CLI_output_bound')
        return super().write(text)


def invoke(cli,argv,path,end):
    check(end)
    output=BoundedText()
    with redirect_stdout(output): code=cli.main(argv)
    check(end)
    launch.require(code==0,'CLI_nonzero')
    text=output.getvalue()
    with Path(path).open('x',encoding='utf-8') as stream: stream.write(text)
    return json.loads(text)


def material_rows(runner,frozen,out):
    rows={}
    def add(row):
        old=rows.get(row['path'])
        launch.require(old is None or old==row,'conflicting_immutable_pin')
        rows[row['path']]=row
    for row in frozen['implementation']+frozen['runtime']['files']:
        add(row)
    for key in ('model','python','native_library'): add(frozen['runtime'][key])
    for path in list(frozen['source_bindings'].values())+[str(p) for p in launch.COMMON]:
        add(runner.file_receipt(path))
    for name in ('source-plan.json','source-bindings.json','limits.json','frozen.json'):
        add(runner.file_receipt(out/name))
    return [rows[key] for key in sorted(rows)]


