"""Source-only focused regression; real owner loop, injected work, memory SQLite."""
from pathlib import Path
import hashlib
import importlib
import sqlite3
import sys
import types
import unittest
from unittest.mock import patch

HERE = Path(__file__).resolve().parent
BASE = HERE.parent / '{{V1_BASELINE_PACKAGE_DIRECTORY}}'
BASE_SHA256 = 'bb3091a5236c2a62647ce3cd4d4b54475f9c8809e50fbc61f2ecbf13757e852d'
if hashlib.sha256((BASE / 'native_owned_cell_store.py').read_bytes()).hexdigest() != BASE_SHA256:
    raise RuntimeError('Run comparison before replacing the pinned installed v1 store')

def load(name, paths):
    package = types.ModuleType(name); package.__path__ = [str(p) for p in paths]
    sys.modules[name] = package
    return importlib.import_module(name + '.native_owned_cell_store')

baseline = load('_owner_diagnostic_baseline', (BASE,))
candidate = load('_owner_diagnostic_candidate', (HERE, BASE))
KINDS = ('receipt', 'publish', 'read', 'detail', 'jobs_detail', 'dispatch',
         'validate_dispatch', 'list', 'jobs_list', 'expire', 'delete', 'sweep')

def run_one(module, kind='publish', error_kind='sqlite'):
    # Do not call start/_open on a real namespace. Only opening and the selected
    # operation are injected; the exact _run catch, result assignment, counter,
    # slot retirement, stop handling and connection close execute unchanged.
    owner = module.CellStore('/not-opened-model-free-owner', None, enabled=True)
    owner._durable = 7
    owner._open = lambda: setattr(owner, '_db', sqlite3.connect(':memory:'))
    owner._scan = lambda budget: {}
    owner._publication_policy = lambda payload: None
    error = (module.Unavailable('cooperative_deadline') if error_kind == 'unavailable'
             else ValueError('private original message') if error_kind == 'ordinary'
             else sqlite3.OperationalError('private original message'))
    if error_kind == 'sqlite':
        error.sqlite_errorcode = sqlite3.SQLITE_INTERRUPT
        error.sqlite_errorname = 'SQLITE_INTERRUPT'
    original_args = error.args
    calls = []
    def fail(*args):
        calls.append(error)
        owner._stop.set(); owner._wake.set()
        raise error
    handler = ('_sweep' if kind == 'sweep' else '_receipt' if kind == 'receipt'
               else '_publish' if kind == 'publish' else '_list' if kind in ('list', 'jobs_list')
               else '_expire' if kind in ('expire', 'delete') else '_read')
    setattr(owner, handler, fail)
    op = None if kind == 'sweep' else module.Operation(kind, ('fixture',), owner._epoch, owner._wake)
    if op is None:owner._reconcile.set()
    else:owner._slot = op; owner._accepted = 1
    owner._wake.set()
    owner._run()
    assert calls == [error] and error.args == original_args
    return {
        'status': owner._status, 'accepted': owner._accepted,
        'dropped': owner._dropped, 'durable': owner._durable,
        'cleanup_pending': owner._cleanup_pending, 'slot': owner._slot,
        'db_closed': owner._db is None, 'ready': owner._ready.is_set(),
        'result': None if op is None else op.wait(0),
        'payload': None if op is None else op.payload,
        'slot_released': None if op is None else op.slot_released.is_set(),
        'calls': len(calls), 'error_args': error.args,
        'sqlite_code': getattr(error, 'sqlite_errorcode', None),
    }

class OwnerDiagnostics(unittest.TestCase):
    def setUp(self):
        candidate._DIAGNOSTIC_COUNT = 0
        self.patcher = patch.object(candidate._LOGGER, 'warning')
        self.warning = self.patcher.start(); self.addCleanup(self.patcher.stop)

    def messages(self):
        return [call.args[0] % call.args[1:] for call in self.warning.call_args_list]

    def test_real_owner_catch_matches_original_without_retry(self):
        for kind in ('receipt', 'publish', 'read', 'detail', 'list', 'delete', 'sweep'):
            for error_kind in ('sqlite', 'ordinary', 'unavailable'):
                with self.subTest(kind=kind, error=error_kind):
                    self.warning.reset_mock()
                    before = run_one(baseline, kind, error_kind)
                    after = run_one(candidate, kind, error_kind)
                    self.assertEqual(before, after)
                    reason = 'cooperative_deadline' if error_kind == 'unavailable' else 'optional_sql_or_io_failure'
                    self.assertEqual(after['status'], reason)
                    self.assertEqual(after['calls'], 1)
                    self.assertEqual(after['durable'], 7)
                    self.assertTrue(after['db_closed']); self.assertFalse(after['ready'])
                    self.assertIsNone(after['slot']); self.assertIsNone(after['payload'])
                    self.assertEqual(after['accepted'], 0 if kind == 'sweep' else 1)
                    self.assertEqual(after['dropped'], 0 if kind == 'sweep' else 1)
                    self.assertEqual(after['cleanup_pending'], kind == 'sweep')
                    if kind == 'sweep':self.assertIsNone(after['result'])
                    else:
                        self.assertTrue(after['slot_released'])
                        status = 'unknown' if kind in ('receipt', 'publish') else 'unavailable'
                        self.assertEqual(after['result'], {'status': status, 'reason': reason})
                    self.assertEqual(len(self.messages()), 1)
                    self.assertIn('stage=owner operation=' + kind, self.messages()[0])
                    self.assertNotIn('private', self.messages()[0])
                    if error_kind == 'sqlite':
                        self.assertIn('exception_class=OperationalError sqlite_code=9 sqlite_name=SQLITE_INTERRUPT', self.messages()[0])

    def test_logger_failure_does_not_replace_original_failure(self):
        self.warning.side_effect = RuntimeError('logger failure')
        for kind in ('receipt', 'publish', 'detail', 'sweep'):
            for error_kind in ('sqlite', 'unavailable'):
                self.assertEqual(run_one(candidate, kind, error_kind), run_one(baseline, kind, error_kind))

    def test_real_owner_failures_obey_shared_cap(self):
        for _ in range(candidate._DIAGNOSTIC_LIMIT + 4):
            result = run_one(candidate)
            self.assertEqual(result['calls'], 1); self.assertEqual(result['dropped'], 1)
        self.assertEqual(len(self.messages()), 32)
        self.assertTrue(all(len(line) <= 1024 and '\n' not in line for line in self.messages()))

    def test_closed_operation_vocabulary_and_safe_tokens(self):
        for kind in KINDS:
            candidate._diagnostic_failure('owner', ValueError('private'), operation=kind)
            self.assertIn('operation=' + kind + ' ', self.messages()[-1])
        for bad in (None, 17, 'publish\nprivate', '/private/path', 'x' * 4096):
            candidate._diagnostic_failure('owner', ValueError('private'), operation=bad)
            self.assertIn('operation=other ', self.messages()[-1])
            self.assertNotIn('private', self.messages()[-1])
        odd = type('bad\nname', (Exception,), {})('private')
        odd.sqlite_errorcode = 'secret'; odd.sqlite_errorname = 'SQLITE_BAD\nsecret'
        candidate._diagnostic_failure('owner', odd, operation='publish')
        self.assertIn('exception_class=other sqlite_code=None sqlite_name=None', self.messages()[-1])

    def test_logging_lock_contention_does_not_block_owner(self):
        with candidate._DIAGNOSTIC_LOCK:
            actual = run_one(candidate)
        self.assertEqual(actual, run_one(baseline)); self.assertEqual(self.messages(), [])

    def test_existing_capture_format_and_budgets_unchanged(self):
        candidate._diagnostic_failure('capture', ValueError('private'))
        self.assertEqual(self.messages(), ['native_owned_capture_failure stage=capture exception_class=ValueError sqlite_code=None sqlite_name=None'])
        for name in ('OP_SECONDS', 'OWNER_OP_SECONDS', 'SQL_STEPS', 'SOURCE_READ_BYTES', 'SQL_PROJECTION_BYTES'):
            self.assertEqual(getattr(candidate, name), getattr(baseline, name))

if __name__ == '__main__':unittest.main(verbosity=2)
