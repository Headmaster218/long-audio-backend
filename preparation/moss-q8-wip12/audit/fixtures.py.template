"""Fixed in-memory GGUF fixtures; never open the model or import native providers."""
import hashlib
import io
import json
from pathlib import Path
import struct
import sys
import unittest

HERE=Path(__file__).resolve().parent

def u32(x):return struct.pack('<I',x)
def u64(x):return struct.pack('<Q',x)
def string(s):
    b=s.encode();return u64(len(b))+b

def value(kind,x):
    if kind==8:return string(x)
    if kind==9:
        subtype,values=x
        return u32(subtype)+u64(len(values))+b''.join(value(subtype,v) for v in values)
    return struct.pack('<'+{0:'B',4:'I',5:'i',6:'f',7:'B',10:'Q',12:'d'}[kind],x)

def fixture(rows=None,tensors=None,data_bytes=4):
    if rows is None:rows=[('general.architecture',8,'moss')]
    if tensors is None:tensors=[('x',(1,),0,0)]
    b=b'GGUF'+u32(3)+u64(len(tensors))+u64(len(rows))
    for key,kind,x in rows:b+=string(key)+u32(kind)+value(kind,x)
    for name,dims,kind,offset in tensors:b+=string(name)+u32(len(dims))+b''.join(u64(d) for d in dims)+u32(kind)+u64(offset)
    b+=b'\0'*((-len(b))%32)
    return b+b'\0'*data_bytes


def run(a):
    class Tests(unittest.TestCase):
        def parse(self,b):return a.parse_gguf(io.BytesIO(b),len(b))
        def refused(self,b):
            with self.assertRaises(a.Refused):self.parse(b)
        def profile(self):
            m=dict(a.EXPECTED);t=a.expected_tensors()
