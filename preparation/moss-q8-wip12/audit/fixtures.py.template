            tokens=['']*151936;tokens[0]=enc(a.PREFIX);tokens[1]=enc(a.SUFFIX)
            for i in range(10):tokens[i+2]=str(i)
            tokens[151671]='<|audio_pad|>';tokens[151645]='<|im_end|>';tokens[151643]='<|endoftext|>'
            m['tokenizer.ggml.tokens']={'array_type':8,'count':151936,'values':tokens}
            m['tokenizer.ggml.token_type']={'array_type':5,'count':151936,'values':None}
            m['tokenizer.ggml.eos_token_id']=151645;m['tokenizer.ggml.padding_token_id']=151643
            source=json.loads((HERE.parent/'__LOCAL_PINNED_PUBLIC_MODEL_METADATA_PATH__').read_text())
            m['tokenizer.chat_template']=source['gguf']['chat_template']
            for key,vals in [('stt.moss.prompt_prefix_tokens',[0]),('stt.moss.prompt_suffix_tokens',[1]+[12]*84),('stt.moss.digit_tokens',list(range(2,12)))]:
                m[key]={'array_type':5,'count':len(vals),'values':vals}
            return m,t
